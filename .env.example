# === Credenciales SMTP (Gmail recomendado) ===
# 1. Ve a https://myaccount.google.com/apppasswords
#    (requiere tener verificación en 2 pasos activada en tu cuenta Google)
# 2. Crea una "Contraseña de aplicación" y pégala en SMTP_PASS (sin espacios)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion

# Nombre que aparece como remitente
FROM_NAME=Mensa Perú Test

# Destinatarios precargados en la web (opcional, separados por coma)
DEFAULT_RECIPIENTS=

# === Login con Google (Fase 1) ===
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Redirect URIs autorizados:
#   http://localhost:3300/auth/google/callback
#   https://TU-APP.vercel.app/auth/google/callback
# Y para conectar Gmail (Fase 3), estos dos más:
#   http://localhost:3300/auth/gmail/callback
#   https://TU-APP.vercel.app/auth/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DÉJALA VACÍA EN LOCAL: sin ella se deduce del host, o sea localhost:3300.
# En Vercel sí hay que fijarla (https://tu-app.vercel.app), porque los deploys
# de preview tienen URLs aleatorias que Google rechaza por no estar registradas.
OAUTH_REDIRECT_BASE=

# Firma la cookie de sesión. Mínimo 32 caracteres:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Quién es admin: entra siempre y es el único que ve el panel /admin.html.
# Va en env var y NO en la base a propósito — si un borrado accidental te
# quitara de la lista, te quedarías fuera de tu propia app sin forma de volver.
ADMIN_EMAILS=tu_correo@gmail.com

# Acceso fijo adicional, correos y/o dominios con @ delante. Es la semilla y
# lo único que funciona si no hay Supabase; con base, el resto se gestiona
# desde el panel. Vacío está bien si ADMIN_EMAILS tiene algo.
# Sin ninguna de las dos no entra nadie: fail-closed a propósito, porque la
# URL de Vercel es pública y los correos salen con TU cuenta de Gmail.
ALLOWED_EMAILS=

# === Base de datos (Fase 2) ===
# Supabase → Settings → API. Se usa SOLO como base de datos (el login lo maneja
# auth.js). Opcional en la Fase 2: sin esto el login funciona pero no persiste
# nada. Obligatorio desde la Fase 3, para guardar los tokens de Gmail.
# La service role key salta RLS: es secreta, nunca la pongas en el frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clave maestra para cifrar los refresh tokens de Gmail (AES-256-GCM).
# Exactamente 32 bytes en base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si la pierdes o la cambias, todos tienen que reconectar su Gmail.
TOKEN_ENC_KEY=

# === Cola y cuotas (Fase 4) ===
# Destinatarios por lote. 20 × ~1 s ≈ 20 s, cómodo bajo el maxDuration de 60 s.
CAMPAIGN_BATCH_SIZE=20

# Tope diario por usuario para su propia cuenta de Gmail. Gmail permite ~500
# (gratuito) o ~2000 (Workspace); deja margen para lo que envíes fuera de aquí.
DAILY_LIMIT_PER_USER=450

# Tope diario de la cuenta SMTP del sistema. Es UNA bandeja compartida: este
# límite se cuenta sumando lo que envían todos los usuarios juntos.
SMTP_DAILY_LIMIT=450

# Tope del envío directo, el que se usa cuando NO hay Supabase (sin base no hay
# dónde guardar la cola, así que se acota para no chocar con el timeout).
MAX_RECIPIENTS_PER_REQUEST=25

# Pausa entre envíos por la API de Gmail. El límite es ~150/min por usuario,
# así que 400 ms deja margen. Bajarlo mucho arriesga 429.
GMAIL_SEND_SPACING_MS=400

# Puerto del servidor web local (no aplica en Vercel)
PORT=3300
